+/// Which of a block's three Huffman tables a complaint is about.
+///
+/// It was a `str` in each of the three variants below that name a table.
+/// Making it an enum is what lets `Error` -- and so `Result<int, Error>`, the
+/// bit reader's return type -- be a value rather than a heap object, and it
+/// is a better spelling in its own right: three names the compiler checks,
+/// not three strings a typo could disagree about.
+pub enum Table {
+    CodeLength;
+    LiteralLength;
+    Distance;
+}
+
+pub str Table.to_str() {
+    match (this) {
+        case CodeLength: {
+            return "code length";
+        }
+        case LiteralLength: {
+            return "literal/length";
+        }
+        case Distance: {
+            return "distance";
+        }
+    }
+}
