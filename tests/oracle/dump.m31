// Dump the tokens this library produces for files, for the oracle
// comparison (tests/oracle/compare.py).
//
//   dump LANG PATH [LANG PATH ...]     (LANG "-" detects it from the path)
//
// Output, per file: `@@ LANG PATH`, then one `LINE START END CLASSNAME` per
// token (line and byte columns 0-based, END exclusive; classes are tree-sitter
// capture names, NORMAL bytes omitted), or `!! reason` when unreadable.

import args;
import io;
import os;
import core.SYN_class;
import core.SYN_detect;
import core.SYN_highlight;

// The command line, in Oro's args grammar (m31's docs/cli-conventions.md).
args.Parser table = args.Parser("dump", summary: "dump the tokens this library produces for files, for the oracle comparison");
table.tail("pairs", placeholder: "LANG PATH", help: "pairs of a language and a file; LANG - detects the language from the path");
table.epilog = "exit status: 0 ok (an unreadable file is a `!!` line in the output), 2 usage error";
args.Parsed given = table.parse_or_exit(os.arguments().slice(1, os.arguments().size()));
List<str> pairs = given.tail("pairs");
if (pairs.size() % 2 != 0) {
    table.fail("'" + pairs[pairs.size() - 1] + "' has no file: arguments come as LANG PATH pairs");
}
int next = 0;
while (next + 1 < pairs.size()) {
    str lang = pairs[next];
    str path = pairs[next + 1];
    next = next + 2;
    match (io.read(path)) {
        case Ok(str text): {
            List<str> lines = text.split("\n");
            if (lang == "-") {
                str first = "";
                if (lines.size() > 0) {
                    first = lines[0];
                }
                lang = SYN_detect.language_of(path, first);
            }
            print("@@ " + lang + " " + path);
            SYN_highlight.Highlighter highlighter = SYN_highlight.Highlighter(language: lang);
            highlighter.set_lines(lines);
            for (int row in 0 .. lines.size()) {
                List<int> spans = highlighter.spans(row);
                int step = 0;
                while (step + 2 < spans.size()) {
                    print(str(row) + " " + str(spans[step]) + " " + str(spans[step + 1]) + " " + SYN_class.name_of(spans[step + 2]));
                    step = step + 3;
                }
            }
        }
        case Err(io.Error failure): {
            print("!! " + path + ": " + failure.to_str());
        }
    }
}
