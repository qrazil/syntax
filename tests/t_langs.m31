check.snap("python", ["import os", "@decorator", "class Foo(Base):", "    def method(self, x: int = 1) -> str:", "        \"\"\"doc", "        string\"\"\"", "        return f\"{x}\" + 'a' # note", "async def run(): await go(None, True)"], ["kkkkkk", "aaaaaaaaaa", "kkkkk ttt tttt", "    kkk ffffff vvvv     ttt   0     ttt", "        ssssss", "sssssssssssssssss", "        kkkkkk ssssss   sss cccccc", "kkkkk kkk fff    kkkkk ll oooo  oooo"]);
