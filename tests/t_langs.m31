// Per-language snapshots: a few lines of real-looking code per language,
// with the class of every byte drawn under it (letters: tests/SYN_check.m31).
// Add a language by adding a block here, reviewed with tests/tools/show.m31.

import tests.SYN_check;

SYN_check.Check check = SYN_check.Check();
check.snap("c", ["#include <stdio.h>", "#define MAX(a, b) ((a) > (b) ? (a) : (b))", "static const char *name = \"hi\\n\"; // note", "int main(int argc, char **argv) {", "    for (size_t i = 0; i < 10u; i++) { printf(\"%d\\n\", i); }", "    struct point p = {0x1F, 'x'};", "    return NULL == p ? -1 : 0;", "}"], ["pppppppp sssssssss", "ppppppp lll", "kkkkkk kkkkk tttt         ssssss  ccccccc", "ttt llll ttt       tttt", "    kkk  tttttt     0      000         llllll ssssss", "    kkkkkk ttttt      0000  sss", "    kkkkkk oooo         0   0", ""]);
check.snap("rust", ["use std::collections::HashMap;", "#[derive(Debug, Clone)]", "pub struct Point<'a> { x: &'a i32, name: String }", "impl Point<'_> {", "    pub fn new(x: i32) -> Self { Self { x } }", "}", "let s = r#\"raw \"q\" \"#; let c = 'x'; let n = 1_000u64;", "println!(\"{} {}\", self.x, s);", "/* block /* nested */ end */"], ["kkk                   ttttttt", "aaaaaaaaaaaaaaaaaaaaaaa", "kkk kkkkkk ttttt              ttt        tttttt", "kkkk ttttt", "    kkk kk fff    ttt     kkkk   kkkk", "", "kkk     sssssssssssss  kkk     sss  kkk     00000000", "lllllll  sssssss  vvvv", "cccccccccccccccccccccccccccc"]);
check.snap("go", ["package main", "import \"fmt\"", "type Server struct { Addr string }", "func (s *Server) Run(n int) error {", "    ch := make(chan int)", "    defer fmt.Println(\"done\", `raw`)", "    return nil", "}"], ["kkkkkkk", "kkkkkk sssss", "kkkk tttttt kkkkkk   tttt tttttt", "kkkk     tttttt  lll   ttt  ttttt", "          llll kkkk ttt", "    kkkkk     lllllll ssssss  sssss", "    kkkkkk ooo", ""]);
check.snap("python", ["import os", "@decorator", "class Foo(Base):", "    def method(self, x: int = 1) -> str:", "        \"\"\"doc", "        string\"\"\"", "        return f\"{x}\" + 'a' # note", "async def run(): await go(None, True)"], ["kkkkkk", "aaaaaaaaaa", "kkkkk ttt tttt", "    kkk ffffff vvvv     ttt   0     ttt", "        ssssss", "sssssssssssssssss", "        kkkkkk ssssss   sss cccccc", "kkkkk kkk fff    kkkkk ll oooo  oooo"]);
check.snap("javascript", ["import { a } from \"b\";", "const f = async (x) => `t ${x}` + 'q'; // c", "class A extends B { static m() { return this.x; } }", "let re = /ab+c/g, n = 0xFF + 1.5e3;"], ["kkkkkk       kkkk sss", "kkkkk     kkkkk        ssssssss   sss  cccc", "kkkkk t kkkkkkk     kkkkkk l     kkkkkk vvvv", "kkk                   0000   00000"]);
check.snap("typescript", ["interface Foo<T> { readonly a: string; b?: number }", "export type Id = number | undefined;", "enum Color { Red, Green }", "function f(x: Foo<string>): void {}"], ["kkkkkkkkk ttt      kkkkkkkk    tttttt      tttttt", "kkkkkk kkkk tt   tttttt   ttttttttt", "kkkk ttttt   ttt  ttttt", "kkkkkkkk f    ttt tttttt    kkkk"]);
check.snap("json", ["{\"a\": [1, -2.5e3, true, null, \"s\\\"q\"], \"b\": {\"c\": \"d\"}}"], [" yyy   0  000000  oooo  oooo  ssssss   yyy   yyy  sss"]);
check.snap("toml", ["[package]", "name = \"syntax\"  # note", "version = \"0.1.0\"", "list = [1, 2.5, true]", "[[bin]]", "s = \"\"\"multi", "line\"\"\""], [" ttttttt", "yyyy   ssssssss  cccccc", "yyyyyyy   sssssss", "yyyy    0  000  oooo", "  ttt", "y   ssssssss", "sssssss"]);
check.snap("yaml", ["name: build  # note", "on:", "  push:", "    branches: [ \"master\" ]", "run: |", "  echo hi", "  make", "key: \"v\"", "- item: 1"], ["yyyy         cccccc", "yy", "  yyyy", "    yyyyyyyy    ssssssss", "yyy", "sssssssss", "ssssss", "yyy  sss", "  yyyy  0"]);
check.snap("sh", ["#!/bin/bash", "set -euo pipefail", "for f in \"$@\"; do echo \"$f\" # c", "  x=${HOME:-/tmp}/a", "done", "cat <<EOF", "body $x", "EOF", "echo after"], ["ccccccccccc", "kkk", "kkk   kk ssss  kk kkkk ssss ccc", "    xxxxxxxxxxxxx", "kkkk", "lll", "sssssss", "sss", "kkkk"]);
check.snap("markdown", ["# Title", "Some *em* and **strong** and `code` and [link](http://x.org) text.", "- item one", "> quote", "```rust", "fn main() {}", "```", "```", "plain", "```"], ["xhhhhhh", "     eeee     bbbbbbbbbb     rrrrrr     uuuuuucccccccccccccc", "x", "x ccccc", "xxxtttt", "kk ffff", "xxx", "xxx", "rrrrr", "xxx"]);
check.snap("m31", ["import tui.core.TUI_buffer;", "pub int add(int a, int b) { return a + b; } // c", "type Point { int x; str name = \"a\"; }", "int c = 'x'; List<int> xs = [1, 2];"], ["kkkkkk          tttttttttt", "kkk kkk lll kkk    kkk      kkkkkk          cccc", "kkkk ttttt   kkk    kkk        sss", "kkk     sss  tttt kkk        0  0"]);
check.snap("cpp", ["#include <vector>", "namespace a { template <typename T> class Foo : public Bar { std::vector<int> v; }; }", "auto s = R\"(raw)\"; nullptr; // c"], ["pppppppp ssssssss", "kkkkkkkkk t   kkkkkkkk  kkkkkkkk    kkkkk ttt   kkkkkk ttt   ttt  tttttt ttt", "kkkk     ssssssss  ooooooo  cccc"]);
check.snap("html", ["<!DOCTYPE html>", "<html lang=\"en\"><body class=\"a b\">", "<!-- c -->", "<script>", "let x = 1; // c", "</script>", "<style>", "a { color: red; }", "</style>", "<p>t &amp; u</p>", "</body>"], ["ppppppppppppppp", "ggggg aaaa ssssgggggg aaaaa sssssg", "cccccccccc", "gggggggg", "kkk     0  cccc", "ggggggggg", "ggggggg", "    yyyyy", "gggggggg", "ggg  xxxxx  gggg", "ggggggg"]);
check.snap("css", ["/* c */", ".a > b:hover, #id { color: #fff; margin: 10px 0 -2px; font-family: \"A\", serif; }", "@media (max-width: 600px) { a { b: url(x.png) } }"], ["ccccccc", "     y              yyyyy        yyyyyy  0000 0       yyyyyyyyyyy  sss", "aaaaaa  yyyyyyyyy  00000        y  lll"]);
check.snap("diff", ["diff --git a/x b/x", "index 1..2 100644", "--- a/x", "+++ b/x", "@@ -1,3 +1,3 @@ fn", " ctx", "-old", "+new"], ["kkkkkkkkkkkkkkkkkk", "kkkkkkkkkkkkkkkkk", "kkkkkkk", "kkkkkkk", "aaaaaaaaaaaaaaafff", "", "----", "++++"]);
check.snap("java", ["package a.b;", "import java.util.List;", "@Override", "public class Foo<T> extends Bar implements Baz {", "    private final int x = 0;", "    public static void main(String[] args) { System.out.println(\"hi\"); }", "}"], ["kkkkkkk", "kkkkkk           tttt", "aaaaaaaaa", "kkkkkk kkkkk ttt    kkkkkkk ttt kkkkkkkkkk ttt", "    kkkkkkk kkkkk ttt     0", "    kkkkkk kkkkkk tttt llll tttttt           tttttt     lllllll ssss", ""]);
check.snap("sql", ["SELECT a, count(*) FROM t WHERE b = 'x' AND c > 10 -- note", "GROUP BY a;", "/* block */ insert into t values (1, 'it''s');"], ["kkkkkk    lllll    kkkk   kkkkk     sss kkk     00 ccccccc", "kkkkk kk", "ccccccccccc kkkkkk kkkk   kkkkkk  0  sssssss"]);
check.snap("lua", ["-- note", "local function f(a, b)", "  return a .. \"s\" + 1", "end", "--[[ long", "comment ]]", "local s = [==[x]==]"], ["ccccccc", "kkkkk kkkkkkkk f", "  kkkkkk      sss   0", "kkk", "ccccccccc", "cccccccccc", "kkkkk     sssssssss"]);
check.snap("dockerfile", ["FROM alpine:3.19 AS build", "RUN echo \"$X\" && make # c", "ENV A=1"], ["kkkk        0000 kk", "kkk      ssss         ccc", "kkk   0"]);
check.finish();
