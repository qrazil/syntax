// Structure helpers: bracket matching, comment toggling, indent hints, symbols.

import core.SYN_highlight;
import core.SYN_structure;
import tests.SYN_check;

SYN_check.Check check = SYN_check.Check();
List<str> lines = ["static int add(int a, int b) {", "    char *s = \"}\"; // }", "    return (a + b);", "}", "struct point { int x; };", "void run(void)", "{", "}"];
SYN_highlight.Highlighter highlighter = SYN_highlight.Highlighter(language: "c");
highlighter.set_lines(lines);
List<int> found = SYN_structure.match_bracket(highlighter, 0, 29);
check.eq_int("brace pairs across strings and comments", found.size(), 2);
check.eq_int("partner line", found[0], 3);
check.eq_int("partner column", found[1], 0);
found = SYN_structure.match_bracket(highlighter, 3, 0);
check.eq_int("backwards", found[0], 0);
check.eq_int("backwards column", found[1], 29);
found = SYN_structure.match_bracket(highlighter, 2, 11);
check.eq_int("parenthesis", found[1], 17);
check.eq_int("not a bracket", SYN_structure.match_bracket(highlighter, 0, 0).size(), 0);
check.eq_int("bracket inside a string is not one", SYN_structure.match_bracket(highlighter, 1, 17).size(), 0);
check.eq_int("bracket inside a comment is not one", SYN_structure.match_bracket(highlighter, 1, 24).size(), 0);
check.eq_int("unmatched", SYN_structure.match_bracket(highlighter, 6, 0)[0], 7);
check.eq_str("c leader", SYN_structure.comment_leader("c"), "// ");
check.eq_str("python leader", SYN_structure.comment_leader("python"), "# ");
check.eq_str("sql leader", SYN_structure.comment_leader("sql"), "-- ");
check.eq_str("json has none", SYN_structure.comment_leader("json"), "");
check.eq_str("css wraps", SYN_structure.comment_forms("css")[1], "/*");
check.eq_str("css wraps, close", SYN_structure.comment_forms("css")[2], "*/");
check.eq_str("css has no leader", SYN_structure.comment_forms("css")[0], "");
check.eq_str("html wraps", SYN_structure.comment_forms("html")[1], "<!--");
check.eq_str("c has both", SYN_structure.comment_forms("c")[0], "// ");
check.eq_str("c block", SYN_structure.comment_forms("c")[2], "*/");
check.eq_str("ocaml wraps", SYN_structure.comment_forms("ocaml")[1], "(*");
check.eq_str("unknown has nothing", SYN_structure.comment_forms("")[0], "");
check.eq_str("comment a line", SYN_structure.comment_line("// ", "    x = 1;"), "    // x = 1;");
check.eq_str("blank lines stay", SYN_structure.comment_line("// ", "  "), "  ");
check.eq_str("uncomment a line", SYN_structure.uncomment_line("// ", "    // x = 1;"), "    x = 1;");
check.eq_str("uncomment without the space", SYN_structure.uncomment_line("// ", "//x"), "x");
check.ok("is_commented", SYN_structure.is_commented("# ", "  # x"));
check.ok("is not commented", !SYN_structure.is_commented("# ", "  x # y"));
check.ok("opens a block", SYN_structure.is_block_opener(highlighter, 0));
check.ok("a comment's brace is no opener", !SYN_structure.is_block_opener(highlighter, 1));
check.ok("a statement opens nothing", !SYN_structure.is_block_opener(highlighter, 2));
check.ok("closes a block", SYN_structure.is_block_closer(highlighter, 3));
check.eq_int("delta of an opener", SYN_structure.indent_delta(highlighter, 0), 1);
check.eq_int("delta of a closer", SYN_structure.indent_delta(highlighter, 3), -1);
List<str> python_lines = ["def f(x):", "    if x:  # c", "        return 1", "    return 2"];
SYN_highlight.Highlighter python_view = SYN_highlight.Highlighter(language: "python");
python_view.set_lines(python_lines);
check.ok("python colon", SYN_structure.is_block_opener(python_view, 0));
check.ok("python colon before a comment", SYN_structure.is_block_opener(python_view, 1));
check.ok("python statement", !SYN_structure.is_block_opener(python_view, 2));
List<str> shell_lines = ["if true; then", "  echo x", "fi"];
SYN_highlight.Highlighter shell_view = SYN_highlight.Highlighter(language: "sh");
shell_view.set_lines(shell_lines);
check.ok("shell then", SYN_structure.is_block_opener(shell_view, 0));
check.ok("shell fi", SYN_structure.is_block_closer(shell_view, 2));
List<SYN_structure.Symbol> symbols = SYN_structure.symbols(highlighter);
check.eq_int("c symbol count", symbols.size(), 3);
check.eq_str("c function", symbols[0].name, "add");
check.eq_str("c function kind", symbols[0].kind, "function");
check.eq_str("c struct", symbols[1].name, "point");
check.eq_str("c struct kind", symbols[1].kind, "type");
check.eq_str("c second function", symbols[2].name, "run");
List<str> rust_lines = ["pub struct A;", "impl A {", "    pub fn new() -> A { A }", "}", "enum E { X }", "trait T {}", "fn main() {}"];
SYN_highlight.Highlighter rust_view = SYN_highlight.Highlighter(language: "rust");
rust_view.set_lines(rust_lines);
List<SYN_structure.Symbol> rust_symbols = SYN_structure.symbols(rust_view);
check.eq_int("rust symbol count", rust_symbols.size(), 5);
check.eq_str("rust new", rust_symbols[1].name, "new");
check.eq_str("rust trait", rust_symbols[3].name, "T");
check.eq_str("rust main", rust_symbols[4].name, "main");
List<str> python_symbol_lines = ["class Foo:", "    def bar(self):", "        pass", "async def baz(): pass"];
SYN_highlight.Highlighter python_symbols_view = SYN_highlight.Highlighter(language: "python");
python_symbols_view.set_lines(python_symbol_lines);
List<SYN_structure.Symbol> py_symbols = SYN_structure.symbols(python_symbols_view);
check.eq_int("python symbol count", py_symbols.size(), 3);
check.eq_str("python class", py_symbols[0].name, "Foo");
check.eq_str("python method", py_symbols[1].name, "bar");
check.eq_int("python method line", py_symbols[1].line, 1);
check.eq_str("python async function", py_symbols[2].name, "baz");
check.finish();
