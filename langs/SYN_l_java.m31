// java.

import core.SYN_lang;

pub SYN_lang.Lang define() {
    SYN_lang.Lang lang = SYN_lang.Lang("java");
    lang.keywords = "abstract assert break case catch class const continue default do else enum extends final finally for goto if implements import instanceof interface native new package private protected public return static strictfp super switch synchronized this throw throws transient try volatile while var record sealed permits yield non-sealed module requires exports opens uses provides to with open transitive";
    lang.types = "boolean byte char short int long float double void String Object Integer Long Double Float Boolean Character Byte Short Number List Map Set Optional Collection Iterable Iterator Class Exception RuntimeException Throwable Thread Runnable StringBuilder Override";
    lang.constants = "true false null";
    lang.specials = "this super";
    lang.decl_type = "class interface enum record @interface";
    lang.attr = "@";
    lang.comment_leader = "// ";
    lang.symbol_style = "c";
    lang.symbol_depth = 1;
    lang.has_members = true;
    lang.has_decl_types = true;
    lang.line_comment("//");
    lang.block_comment("/*", "*/", "");
    lang.string("\"\"\"", "\"\"\"", "\\", "m");
    lang.string("\"", "\"", "\\", "");
    lang.string("'", "'", "\\", "c");
    return lang.build();
}
