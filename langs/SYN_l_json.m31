// json.

import core.SYN_lang;

pub SYN_lang.Lang define() {
    SYN_lang.Lang lang = SYN_lang.Lang("json");
    lang.constants = "true false null";
    lang.has_string_keys = true;
    lang.has_signed_numbers = true;
    lang.has_caps = false;
    lang.has_calls = false;
    lang.string("\"", "\"", "\\", "");
    return lang.build();
}
