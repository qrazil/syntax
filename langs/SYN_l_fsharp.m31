// F#.

import core.SYN_lang;

pub SYN_lang.Lang define() {
    SYN_lang.Lang lang = SYN_lang.Lang("fsharp");
    lang.keywords = "abstract and as assert base begin class default delegate do done downcast downto elif else end exception extern false finally fixed for fun function global if in inherit inline interface internal lazy let match member module mutable namespace new not null of open or override private public rec return sig static struct then to true try type upcast use val void when while with yield async task";
    lang.types = "int int64 float double bool char string unit list array option byte decimal obj seq Map Set";
    lang.constants = "true false None Some Ok Error";
    lang.decl_type = "type module namespace exception";
    lang.word_body = "'";
    lang.comment_leader = "// ";
    lang.line_comment("//");
    lang.block_comment("(*", "*)", "n");
    lang.string("\"\"\"", "\"\"\"", "", "m");
    lang.string("@\"", "\"", "doubled", "");
    lang.string("\"", "\"", "\\", "");
    lang.string("'", "'", "\\", "c");
    return lang.build();
}
