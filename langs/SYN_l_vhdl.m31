// VHDL.

import core.SYN_lang;

pub SYN_lang.Lang define() {
    SYN_lang.Lang lang = SYN_lang.Lang("vhdl");
    lang.keywords = "library use entity is port map architecture of begin end process if then else elsif case when others for loop while signal variable constant type subtype generic component package body function procedure return in out inout buffer to downto array record range attribute wait until after report assert severity generate block with select null exit next open all and or not nand nor xor xnor mod rem abs";
    lang.types = "std_logic std_logic_vector std_ulogic bit bit_vector integer natural positive boolean character string real time unsigned signed";
    lang.constants = "true false";
    lang.decl_fn = "function procedure";
    lang.decl_type = "entity architecture package component type subtype";
    lang.comment_leader = "-- ";
    lang.is_case_folded = true;
    lang.has_caps = false;
    lang.line_comment("--");
    lang.string("\"", "\"", "\\", "");
    lang.string("'", "'", "", "c");
    return lang.build();
}
