// css.

import core.SYN_lang;

pub SYN_lang.Lang define() {
    SYN_lang.Lang lang = SYN_lang.Lang("css");
    lang.word_start = "-";
    lang.word_body = "-";
    lang.attr = "@";
    lang.has_keys = true;
    lang.has_caps = false;
    lang.block_comment("/*", "*/", "");
    lang.string("\"", "\"", "\\", "");
    lang.string("'", "'", "\\", "");
    return lang.build();
}
