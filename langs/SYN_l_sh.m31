// sh.

import core.SYN_lang;

pub SYN_lang.Lang define() {
    SYN_lang.Lang lang = SYN_lang.Lang("sh");
    lang.keywords = "if then else elif fi case in esac for do done select until while declare typeset readonly local unset export function";
    lang.constants = "true false";
    lang.decl_fn = "function";
    lang.sigil = "$";
    lang.comment_leader = "# ";
    lang.indent_style = "keyword";
    lang.needs_comment_space = true;
    lang.has_heredoc = true;
    lang.has_commands = true;
    lang.has_shebang = true;
    lang.has_caps = false;
    lang.has_calls = false;
    lang.line_comment("#");
    lang.string("\"", "\"", "\\", "im");
    lang.string("'", "'", "", "m");
    return lang.build();
}
