// dart.

import core.SYN_lang;

pub SYN_lang.Lang define() {
    SYN_lang.Lang lang = SYN_lang.Lang("dart");
    lang.keywords = "abstract as assert async await break case catch class const continue covariant default deferred do dynamic else enum export extends extension external factory false final finally for Function get hide if implements import in interface is late library mixin new null on operator part required rethrow return sealed set show static super switch sync this throw true try typedef var void when while with yield base";
    lang.types = "int double num bool String List Map Set Object dynamic void Future Stream Iterable Duration DateTime Never Null Type Symbol";
    lang.constants = "true false null";
    lang.specials = "this super";
    lang.decl_type = "class mixin enum extension typedef";
    lang.attr = "@";
    lang.comment_leader = "// ";
    lang.has_members = true;
    lang.has_decl_types = true;
    lang.line_comment("//");
    lang.block_comment("/*", "*/", "n");
    lang.string("'''", "'''", "\\", "m");
    lang.string("\"\"\"", "\"\"\"", "\\", "m");
    lang.string("\"", "\"", "\\", "");
    lang.string("'", "'", "\\", "");
    return lang.build();
}
