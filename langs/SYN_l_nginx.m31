// nginx.

import core.SYN_lang;

pub SYN_lang.Lang define() {
    SYN_lang.Lang lang = SYN_lang.Lang("nginx");
    lang.constants = "on off";
    lang.comment_leader = "# ";
    lang.has_caps = false;
    lang.has_calls = false;
    lang.line_comment("#");
    lang.string("\"", "\"", "\\", "");
    lang.string("'", "'", "\\", "");
    return lang.build();
}
