// INI.

import core.SYN_lang;

pub SYN_lang.Lang define() {
    SYN_lang.Lang lang = SYN_lang.Lang("ini");
    lang.mode = "ini";
    lang.constants = "true false yes no on off";
    lang.comment_leader = "; ";
    lang.has_keys = true;
    lang.has_sections = true;
    lang.has_caps = false;
    lang.has_calls = false;
    lang.line_comment(";");
    lang.line_comment("#");
    lang.string("\"", "\"", "\\", "");
    lang.string("'", "'", "\\", "");
    return lang.build();
}
