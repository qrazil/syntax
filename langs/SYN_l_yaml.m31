// yaml.

import core.SYN_lang;

pub SYN_lang.Lang define() {
    SYN_lang.Lang lang = SYN_lang.Lang("yaml");
    lang.mode = "yaml";
    lang.constants = "true false null True False Null TRUE FALSE NULL ~";
    lang.comment_leader = "# ";
    lang.indent_style = "offside";
    lang.needs_comment_space = true;
    lang.has_keys = true;
    lang.has_caps = false;
    lang.has_calls = false;
    lang.line_comment("#");
    lang.string("\"", "\"", "\\", "");
    lang.string("'", "'", "doubled", "");
    return lang.build();
}
