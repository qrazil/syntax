// The generic code scanner: comments, strings, numbers, words, driven by a
// compiled `Lang`. One pass over the line, a table lookup per byte.
//
// State carried across lines (low 12 bits; the rest belongs to the host):
//   kind = state & 15            0 plain, 1 inside a block comment,
//                                2 inside a multi-line string,
//                                3 inside a heredoc (hash of its end word in bits 12..)
//   index = (state >> 4) & 15    which comment or string form
//   level = (state >> 8) & 15    nesting depth, or `=` count of a long bracket

import core.SYN_class;
import core.SYN_lang;
import core.SYN_scanner;

const int K_BLOCK = 1;
const int K_STRING = 2;
const int K_HEREDOC = 3;
const int K_CONTINUED = 4;
const Array<str> REGEX_AFTER = ["return", "typeof", "case", "in", "of", "delete", "void", "throw", "new", "else", "do", "instanceof", "yield", "await"];

bool is_digit_byte(int byte) {
    return byte >= 48 && byte <= 57;
}

bool is_space(int byte) {
    return byte == 32 || byte == 9;
}

pub bool is_match_at(str line, int position, str pattern) {
    int length = pattern.size();
    if (position < 0 || position + length > line.size()) {
        return false;
    }
    for (int index in 0 .. length) {
        if (line.byte_at(position + index) != pattern.byte_at(index)) {
            return false;
        }
    }
    return true;
}

// the position after the closing delimiter of block comment form `form`,
// scanning from `from` with `depth` open levels (or the `=` count of a long
// bracket); a negative answer -(d + 1) means still open at depth d
int block_end(SYN_lang.Lang lang, str line, int from, int form, int depth) {
    str closer = lang.block_comments[form * 3 + 1];
    str flags = lang.block_comments[form * 3 + 2];
    bool is_nesting = flags.contains("n");
    if (flags.contains("L")) {
        closer = "]" + "=".repeat(depth) + "]";
    }
    str open = lang.block_comments[form * 3];
    int level = depth;
    int position = from;
    int size = line.size();
    while (position < size) {
        if (is_nesting && is_match_at(line, position, open)) {
            level = level + 1;
            position = position + open.size();
        } else if (is_match_at(line, position, closer)) {
            position = position + closer.size();
            level = level - 1;
            if (level <= 0 || !is_nesting) {
                return position;
            }
        } else {
            position = position + 1;
        }
    }
    return -(level + 1);
}

// the position after the closing delimiter of string form `form` scanning
// from `from`, or -1 when the line ends first
int string_end(SYN_lang.Lang lang, str line, int from, int form, int level) {
    str closer = lang.strings[form * 4 + 1];
    str esc = lang.strings[form * 4 + 2];
    str flags = lang.strings[form * 4 + 3];
    if (flags.contains("R")) {
        closer = "\"" + "#".repeat(level);
    } else if (flags.contains("L")) {
        closer = "]" + "=".repeat(level) + "]";
    }
    int esc_byte = -1;
    if (esc.size() == 1) {
        esc_byte = esc.byte_at(0);
    }
    bool is_doubled = esc == "doubled";
    int first = closer.byte_at(0);
    int size = line.size();
    int position = from;
    while (position < size) {
        int byte = line.byte_at(position);
        if (byte == esc_byte) {
            position = position + 2;
        } else if (byte == first && is_match_at(line, position, closer)) {
            if (is_doubled && is_match_at(line, position + closer.size(), closer)) {
                position = position + 2 * closer.size();
            } else {
                return position + closer.size();
            }
        } else {
            position = position + 1;
        }
    }
    return -1;
}

int number_end(str line, int from) {
    int size = line.size();
    int position = from;
    if (position + 1 < size && line.byte_at(position) == 48) {
        int next = line.byte_at(position + 1);
        if (next == 120 || next == 88 || next == 98 || next == 66 || next == 111 || next == 79) {
            position = position + 2;
            while (position < size && is_alnum(line.byte_at(position))) {
                position = position + 1;
            }
            return position;
        }
    }
    while (position < size) {
        int byte = line.byte_at(position);
        if ((byte >= 48 && byte <= 57) || byte == 95) {
            position = position + 1;
        } else if (byte == 46 && position + 1 < size && line.byte_at(position + 1) >= 48 && line.byte_at(position + 1) <= 57) {
            position = position + 1;
        } else if ((byte == 101 || byte == 69) && position + 1 < size && ((line.byte_at(position + 1) >= 48 && line.byte_at(position + 1) <= 57) || line.byte_at(position + 1) == 45 || line.byte_at(position + 1) == 43)) {
            position = position + 2;
        } else if (is_alpha(byte)) {
            position = position + 1;
        } else {
            break;
        }
    }
    return position;
}

bool is_alpha(int byte) {
    return (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95 || byte >= 128;
}

pub bool is_alnum(int byte) {
    return is_alpha(byte) || (byte >= 48 && byte <= 57);
}

// a short char literal at `position` (the quote): the position after it, or -1
int char_end(str line, int position, int quote) {
    int size = line.size();
    if (position + 2 >= size) {
        return -1;
    }
    int byte = line.byte_at(position + 1);
    if (byte == 92) {
        int probe = position + 2;
        int limit = position + 12;
        if (limit > size) {
            limit = size;
        }
        while (probe < limit) {
            if (line.byte_at(probe) == quote) {
                return probe + 1;
            }
            probe = probe + 1;
        }
        return -1;
    }
    int length = 1;
    if (byte >= 240) {
        length = 4;
    } else if (byte >= 224) {
        length = 3;
    } else if (byte >= 192) {
        length = 2;
    }
    if (position + 1 + length < size && line.byte_at(position + 1 + length) == quote && byte != quote) {
        return position + 2 + length;
    }
    return -1;
}

// does a string form start at `position`? the form index, or -1
int string_form_at(SYN_lang.Lang lang, str line, int position) {
    int form = 0;
    int count = lang.strings.size() / 4;
    while (form < count) {
        str open = lang.strings[form * 4];
        str flags = lang.strings[form * 4 + 3];
        if (is_match_at(line, position, open)) {
            if (flags.contains("R")) {
                int probe = position + open.size();
                while (probe < line.size() && line.byte_at(probe) == 35) {
                    probe = probe + 1;
                }
                if (probe < line.size() && line.byte_at(probe) == 34 && (position == 0 || !is_alnum(line.byte_at(position - 1)))) {
                    return form;
                }
            } else if (flags.contains("L")) {
                int probe = position + open.size();
                while (probe < line.size() && line.byte_at(probe) == 61) {
                    probe = probe + 1;
                }
                if (probe < line.size() && line.byte_at(probe) == 91) {
                    return form;
                }
            } else if (flags.contains("c")) {
                if (char_end(line, position, open.byte_at(0)) > 0) {
                    return form;
                }
            } else {
                return form;
            }
        }
        form = form + 1;
    }
    return -1;
}

// the end of the opening delimiter of a Rust raw / Lua long form at `position`,
// and the level, packed: (level << 20) | position after the opening
int open_end(SYN_lang.Lang lang, str line, int position, int form) {
    str open = lang.strings[form * 4];
    str flags = lang.strings[form * 4 + 3];
    int probe = position + open.size();
    int level = 0;
    if (flags.contains("R")) {
        while (probe < line.size() && line.byte_at(probe) == 35) {
            level = level + 1;
            probe = probe + 1;
        }
        probe = probe + 1;
    } else if (flags.contains("L")) {
        while (probe < line.size() && line.byte_at(probe) == 61) {
            level = level + 1;
            probe = probe + 1;
        }
        probe = probe + 1;
    }
    if (level > 15) {
        level = 15;
    }
    return (level << 20) | probe;
}

// does a block comment form start at `position`? the form index, or -1
int block_form_at(SYN_lang.Lang lang, str line, int position) {
    int form = 0;
    int count = lang.block_comments.size() / 3;
    while (form < count) {
        str open = lang.block_comments[form * 3];
        if (is_match_at(line, position, open)) {
            if (lang.block_comments[form * 3 + 2].contains("L")) {
                int probe = position + open.size();
                while (probe < line.size() && line.byte_at(probe) == 61) {
                    probe = probe + 1;
                }
                if (probe < line.size() && line.byte_at(probe) == 91) {
                    return form;
                }
            } else {
                return form;
            }
        }
        form = form + 1;
    }
    return -1;
}

bool is_line_comment_at(SYN_lang.Lang lang, str line, int position) {
    if (lang.needs_comment_space && position > 0 && !is_space(line.byte_at(position - 1))) {
        return false;
    }
    for (str open in lang.line_comments) {
        if (is_match_at(line, position, open)) {
            return true;
        }
    }
    return false;
}

// then, else, elif, do, while, until, if, time: a command follows
bool is_command_keyword(str line, int from, int upto) {
    int length = upto - from;
    if (length < 2 || length > 5) {
        return false;
    }
    return is_match_at(line, from, "then") || is_match_at(line, from, "else") || is_match_at(line, from, "elif") || is_match_at(line, from, "do") || is_match_at(line, from, "while") || is_match_at(line, from, "until") || is_match_at(line, from, "if") || is_match_at(line, from, "time");
}

// import, from, use, using, package, include, require: a line that names
// modules, whose dotted names are not member accesses
bool is_import_word(str line, int from, int upto) {
    int length = upto - from;
    if (length < 3 || length > 7) {
        return false;
    }
    return is_match_at(line, from, "import") || is_match_at(line, from, "from") || is_match_at(line, from, "use") || is_match_at(line, from, "using") || is_match_at(line, from, "package") || is_match_at(line, from, "include") || is_match_at(line, from, "require") || is_match_at(line, from, "extern");
}

// can a `/` at `at` begin a regex literal (JavaScript's rule: an operand
// does not precede it)? the end of the literal, or -1
int regex_end(str line, int start) {
    int size = line.size();
    int before = start - 1;
    while (before >= 0 && is_space(line.byte_at(before))) {
        before = before - 1;
    }
    if (before >= 0) {
        int previous = line.byte_at(before);
        bool is_operand = is_alnum(previous) || previous == 41 || previous == 93 || previous == 39 || previous == 34 || previous == 96;
        if (is_operand) {
            // a keyword before it still allows a regex
            int word_start = before;
            while (word_start > 0 && is_alnum(line.byte_at(word_start - 1))) {
                word_start = word_start - 1;
            }
            bool is_keyword = false;
            for (str word in REGEX_AFTER) {
                if (before - word_start + 1 == word.size() && is_match_at(line, word_start, word)) {
                    is_keyword = true;
                }
            }
            if (!is_keyword) {
                return -1;
            }
        }
    }
    int index = start + 1;
    bool is_class = false;
    if (index >= size) {
        return -1;
    }
    while (index < size) {
        int byte = line.byte_at(index);
        if (byte == 92) {
            index = index + 2;
            continue;
        }
        if (byte == 91) {
            is_class = true;
        } else if (byte == 93) {
            is_class = false;
        } else if (byte == 47 && !is_class) {
            if (index == start + 1) {
                return -1;
            }
            index = index + 1;
            while (index < size && is_alpha(line.byte_at(index))) {
                index = index + 1;
            }
            return index;
        }
        index = index + 1;
    }
    return -1;
}

// the end of the variable reference whose sigil is at `at` ($name, ${...},
// $1, $?), or `at + 1` when nothing follows that names one
int variable_end(str line, int start) {
    int size = line.size();
    int stop = start + 1;
    if (stop >= size) {
        return stop;
    }
    if (line.byte_at(stop) == 123) {
        int shut = stop;
        while (shut < size && line.byte_at(shut) != 125) {
            shut = shut + 1;
        }
        if (shut < size) {
            return shut + 1;
        }
        return size;
    }
    if (line.byte_at(stop) == 40) {
        return start + 1;
    }
    while (stop < size && is_alnum(line.byte_at(stop))) {
        stop = stop + 1;
    }
    if (stop == start + 1 && "?!#@*$-".contains(str.from_chars([line.byte_at(stop)]))) {
        stop = stop + 1;
    }
    return stop;
}

// The name inside the variable reference [from, upto) when it is a capitals
// name (or a special parameter, `$1`, `$?`), as (start << 20) | stop; -1 when
// it is not, and tree-sitter's shell leaves it alone.
int variable_constant(str line, int from, int upto) {
    int name_from = from + 1;
    if (name_from < upto && line.byte_at(name_from) == 123) {
        name_from = name_from + 1;
    }
    int name_to = name_from;
    while (name_to < upto && is_alnum(line.byte_at(name_to))) {
        name_to = name_to + 1;
    }
    if (name_to == name_from && name_from < upto && line.byte_at(name_from) != 125) {
        name_to = name_from + 1;
    }
    if (name_to == name_from) {
        return -1;
    }
    for (int index in name_from .. name_to) {
        int byte = line.byte_at(index);
        if (byte >= 97 && byte <= 122) {
            return -1;
        }
    }
    return (name_from << 20) | name_to;
}

// A block comment's bytes [from, upto). In a doc comment (`/** */`) the
// `@tag`s are keywords and `{Type}`s types, as tree-sitter's jsdoc has them.
void emit_comment(SYN_scanner.Scanner scanner, str line, int from, int upto, bool is_doc) {
    if (!is_doc) {
        scanner.emit(from, upto, SYN_class.COMMENT);
        return;
    }
    int position = from;
    int run = from;
    while (position < upto) {
        int byte = line.byte_at(position);
        if (byte == 64 && position + 1 < upto && is_alpha(line.byte_at(position + 1)) && (position == from || !is_alnum(line.byte_at(position - 1)))) {
            int stop = position + 1;
            while (stop < upto && is_alnum(line.byte_at(stop))) {
                stop = stop + 1;
            }
            scanner.emit(run, position, SYN_class.COMMENT);
            scanner.emit(position, stop, SYN_class.KEYWORD);
            position = stop;
            run = stop;
        } else if (byte == 123) {
            int depth = 1;
            int stop = position + 1;
            while (stop < upto && depth > 0) {
                if (line.byte_at(stop) == 123) {
                    depth = depth + 1;
                } else if (line.byte_at(stop) == 125) {
                    depth = depth - 1;
                }
                stop = stop + 1;
            }
            if (depth == 0) {
                scanner.emit(run, position, SYN_class.COMMENT);
                scanner.emit(position + 1, stop - 1, SYN_class.TYPE);
                scanner.emit(position, position + 1, SYN_class.COMMENT);
                position = stop;
                run = stop;
            } else {
                position = position + 1;
            }
        } else {
            position = position + 1;
        }
    }
    scanner.emit(run, upto, SYN_class.COMMENT);
}

// the first non-blank byte at or after `from`, or -1
int next_byte(str line, int from) {
    int position = from;
    while (position < line.size() && is_space(line.byte_at(position))) {
        position = position + 1;
    }
    if (position >= line.size()) {
        return -1;
    }
    return line.byte_at(position);
}

// a function value after `key:` -- `function`, `async`, `(a) =>`, `x =>`
bool is_function_value(str line, int from) {
    int position = from;
    while (position < line.size() && is_space(line.byte_at(position))) {
        position = position + 1;
    }
    if (position >= line.size()) {
        return false;
    }
    if (is_match_at(line, position, "function") || is_match_at(line, position, "async")) {
        return true;
    }
    int byte = line.byte_at(position);
    if (byte == 40) {
        int depth = 0;
        int probe = position;
        while (probe < line.size()) {
            if (line.byte_at(probe) == 40) {
                depth = depth + 1;
            } else if (line.byte_at(probe) == 41) {
                depth = depth - 1;
                if (depth == 0) {
                    break;
                }
            }
            probe = probe + 1;
        }
        return probe + 1 < line.size() && next_byte(line, probe + 1) == 61 && line.substr(probe + 1, line.size()).trim().starts_with("=>");
    }
    if (is_alpha(byte) || byte == 36) {
        int probe = position;
        while (probe < line.size() && (is_alnum(line.byte_at(probe)) || line.byte_at(probe) == 36)) {
            probe = probe + 1;
        }
        return line.substr(probe, line.size()).trim().starts_with("=>");
    }
    return false;
}

// `key:` in an object literal: after `{`, `,` or at the start of the line
bool is_object_key(SYN_lang.Lang lang, str line, int position, int colon) {
    int before = position - 1;
    while (before >= 0 && is_space(line.byte_at(before))) {
        before = before - 1;
    }
    if (before < 0) {
        return true;
    }
    int byte = line.byte_at(before);
    if (byte == 123 || byte == 44) {
        // a typed parameter list `(a: number, b: string)` is not a key; an
        // arrow-valued key is one wherever it stands
        return lang.has_object_keys || is_function_value(line, colon + 1);
    }
    return is_function_value(line, colon + 1) && lang.has_arrow_keys;
}

// A string's bytes [from, upto): STRING, with escapes (`\n`, `\x41`, `\u{1F600}`,
// `\101`) as SPECIAL, as the form's single escape byte says.
void emit_string(SYN_scanner.Scanner scanner, SYN_lang.Lang lang, str line, int from, int upto, int form, int base_class) {
    str esc = lang.strings[form * 4 + 2];
    bool is_interpolating = lang.sigil.size() > 0 && lang.strings[form * 4 + 3].contains("i");
    if ((esc.size() != 1 && !is_interpolating) || base_class != SYN_class.STRING) {
        scanner.emit(from, upto, base_class);
        return;
    }
    int esc_byte = -1;
    if (esc.size() == 1) {
        esc_byte = esc.byte_at(0);
    }
    int position = from;
    int run = from;
    while (position < upto) {
        if (is_interpolating && lang.has_commands && line.byte_at(position) != esc_byte && ((line.byte_at(position) == 36 && position + 1 < upto && line.byte_at(position + 1) == 40) || line.byte_at(position) == 96)) {
            // $( ... ) and ` ... `: code inside the string
            int open_length = 1;
            int closer = 41;
            if (line.byte_at(position) == 96) {
                closer = 96;
            } else {
                open_length = 2;
            }
            int depth = 1;
            int inner_end = position + open_length;
            while (inner_end < upto) {
                int inner_byte = line.byte_at(inner_end);
                if (inner_byte == 92) {
                    inner_end = inner_end + 2;
                    continue;
                }
                if (closer == 41 && inner_byte == 40) {
                    depth = depth + 1;
                } else if (inner_byte == closer) {
                    depth = depth - 1;
                    if (depth == 0) {
                        break;
                    }
                }
                inner_end = inner_end + 1;
            }
            if (inner_end < upto) {
                scanner.emit(run, position, base_class);
                int saved_state = scanner.state;
                List<int> saved = scanner.spans;
                scanner.spans = [];
                int inner_from = position + open_length;
                scan(scanner, lang, line.substr(inner_from, inner_end), 0);
                List<int> inside = scanner.spans;
                scanner.spans = saved;
                scanner.state = saved_state;
                int inner_at = 0;
                while (inner_at + 2 < inside.size()) {
                    scanner.emit(inside[inner_at] + inner_from, inside[inner_at + 1] + inner_from, inside[inner_at + 2]);
                    inner_at = inner_at + 3;
                }
                position = inner_end + 1;
                run = position;
                continue;
            }
            position = position + 1;
        } else if (is_interpolating && line.byte_at(position) != esc_byte && lang.sigil.contains(str.from_chars([line.byte_at(position)])) && position + 1 < upto) {
            int stop = variable_end(line, position);
            if (stop > upto) {
                stop = upto;
            }
            if (stop > position + 1) {
                // tree-sitter paints the whole reference plain inside a string
                scanner.emit(run, position, base_class);
                int named = variable_constant(line, position, stop);
                if (named >= 0) {
                    scanner.emit(named >> 20, named & 0xFFFFF, SYN_class.CONSTANT);
                }
                position = stop;
                run = stop;
                continue;
            }
            position = position + 1;
        } else if (esc_byte >= 0 && line.byte_at(position) == esc_byte && position + 1 < upto) {
            int length = 2;
            int next = line.byte_at(position + 1);
            if (next == 120) {
                length = 4;
            } else if (next == 117) {
                length = 6;
                if (position + 2 < upto && line.byte_at(position + 2) == 123) {
                    int shut = position + 3;
                    while (shut < upto && line.byte_at(shut) != 125) {
                        shut = shut + 1;
                    }
                    length = shut - position + 1;
                }
            } else if (next == 85) {
                length = 10;
            } else if (next >= 48 && next <= 55) {
                length = 2;
                while (length < 4 && position + length < upto && line.byte_at(position + length) >= 48 && line.byte_at(position + length) <= 55) {
                    length = length + 1;
                }
            }
            if (position + length > upto) {
                length = upto - position;
            }
            scanner.emit(run, position, base_class);
            scanner.emit(position, position + length, SYN_class.SPECIAL);
            position = position + length;
            run = position;
        } else {
            position = position + 1;
        }
    }
    scanner.emit(run, upto, base_class);
}

/// Scan one line of a code language from `state`; fills `scanner.spans` and
/// `scanner.state`.
pub void scan(SYN_scanner.Scanner scanner, SYN_lang.Lang lang, str line, int state) {
    int size = line.size();
    int position = 0;
    int kind = state & 15;
    int form = (state >> 4) & 15;
    int level = (state >> 8) & 15;
    scanner.state = 0;
    if (kind == K_BLOCK) {
        int end = block_end(lang, line, 0, form, level);
        bool is_doc = ((state >> 12) & 1) != 0;
        if (end < 0) {
            emit_comment(scanner, line, 0, size, is_doc);
            scanner.state = K_BLOCK | (form << 4) | ((-end - 1) << 8) | (state & 4096);
            if (level > 15) {
                scanner.state = K_BLOCK | (form << 4) | (15 << 8) | (state & 4096);
            }
            return;
        }
        emit_comment(scanner, line, 0, end, is_doc);
        position = end;
    } else if (kind == K_STRING) {
        int end = string_end(lang, line, 0, form, level);
        if (end < 0) {
            emit_string(scanner, lang, line, 0, size, form, SYN_class.STRING);
            scanner.state = state;
            return;
        }
        emit_string(scanner, lang, line, 0, end, form, SYN_class.STRING);
        position = end;
    } else if (kind == K_HEREDOC) {
        int begin = 0;
        int finish = size;
        while (begin < finish && is_space(line.byte_at(begin))) {
            begin = begin + 1;
        }
        while (finish > begin && (is_space(line.byte_at(finish - 1)) || line.byte_at(finish - 1) == 13)) {
            finish = finish - 1;
        }
        scanner.emit(0, size, SYN_class.STRING);
        if (SYN_lang.hash_of(line, begin, finish, false) == (state >> 12)) {
            scanner.state = 0;
        } else {
            scanner.state = state;
        }
        return;
    }
    int pending = 0;
    int heredoc = 0;
    bool is_command = lang.has_commands && kind != K_CONTINUED;
    if (lang.has_shebang && position == 0 && size > 2 && line.byte_at(0) == 35 && line.byte_at(1) == 33) {
        scanner.emit(0, size, SYN_class.PREPROC);
        return;
    }
    bool is_first_word = true;
    bool is_import_line = false;
    int last_plain_start = 0;
    int last_plain_stop = 0;
    bool is_first = true;
    if (lang.has_sections && position == 0) {
        // `[table]` / `[[array]]` / `[section]`: the whole line names a table
        int begin = 0;
        while (begin < size && is_space(line.byte_at(begin))) {
            begin = begin + 1;
        }
        int finish = size;
        while (finish > begin && (is_space(line.byte_at(finish - 1)) || line.byte_at(finish - 1) == 13)) {
            finish = finish - 1;
        }
        if (begin < finish && line.byte_at(begin) == 91 && line.byte_at(finish - 1) == 93) {
            int inner = begin;
            while (inner < finish && line.byte_at(inner) == 91) {
                inner = inner + 1;
            }
            int stop = finish;
            while (stop > inner && line.byte_at(stop - 1) == 93) {
                stop = stop - 1;
            }
            scanner.emit(inner, stop, SYN_class.TYPE);
            return;
        }
    }
    while (position < size) {
        int byte = line.byte_at(position);
        int mask = lang.start[byte];
        if (mask == 0) {
            if (byte != 32 && byte != 9) {
                pending = 0;
                is_command = lang.has_commands && lang.command_starts.contains(str.from_chars([byte]));
                if (lang.has_commands && (byte == 62 || byte == 60) && position + 1 < size && line.byte_at(position + 1) != 40 && line.byte_at(position + 1) != 60 && line.byte_at(position + 1) != 38) {
                    // a redirect target is a path
                    int target = position + 1;
                    if (line.byte_at(target) == 62) {
                        target = target + 1;
                    }
                    while (target < size && is_space(line.byte_at(target))) {
                        target = target + 1;
                    }
                    int target_end = target;
                    while (target_end < size && !is_space(line.byte_at(target_end)) && line.byte_at(target_end) != 59 && line.byte_at(target_end) != 124 && line.byte_at(target_end) != 38 && line.byte_at(target_end) != 41 && line.byte_at(target_end) != 36 && line.byte_at(target_end) != 34 && line.byte_at(target_end) != 39) {
                        target_end = target_end + 1;
                    }
                    if (target_end > target) {
                        scanner.emit(target, target_end, SYN_class.SPECIAL);
                        position = target_end;
                        continue;
                    }
                }
            }
            position = position + 1;
            continue;
        }
        if (is_first && (mask & SYN_lang.M_PREPROC) != 0) {
            // only the is_first non-blank byte of the line
            bool is_lead = true;
            for (int step in 0 .. position) {
                if (!is_space(line.byte_at(step))) {
                    is_lead = false;
                }
            }
            if (is_lead) {
                int stop = position + 1;
                while (stop < size && is_space(line.byte_at(stop))) {
                    stop = stop + 1;
                }
                while (stop < size && is_alnum(line.byte_at(stop))) {
                    stop = stop + 1;
                }
                int directive_from = position + 1;
                while (directive_from < stop && is_space(line.byte_at(directive_from))) {
                    directive_from = directive_from + 1;
                }
                int directive_class = SYN_class.PREPROC;
                if (stop - directive_from == 7 && is_match_at(line, directive_from, "include")) {
                    directive_class = SYN_class.KEYWORD;
                }
                scanner.emit(position, stop, directive_class);
                position = stop;
                is_first = false;
                if (lang.has_include_angle && stop > directive_from) {
                    str directive = line.substr(directive_from, stop);
                    if (directive == "define" || directive == "ifdef" || directive == "ifndef" || directive == "undef") {
                        // the macro's name: a constant, or a function when it takes arguments
                        int name_from = position;
                        while (name_from < size && is_space(line.byte_at(name_from))) {
                            name_from = name_from + 1;
                        }
                        int name_to = name_from;
                        while (name_to < size && is_alnum(line.byte_at(name_to))) {
                            name_to = name_to + 1;
                        }
                        if (name_to > name_from) {
                            int name_class = SYN_class.CONSTANT;
                            if (directive == "define" && name_to < size && line.byte_at(name_to) == 40) {
                                name_class = SYN_class.CALL;
                            }
                            scanner.emit(name_from, name_to, name_class);
                            position = name_to;
                        }
                    }
                }
                if (lang.has_include_angle) {
                    int rest = position;
                    while (rest < size && is_space(line.byte_at(rest))) {
                        rest = rest + 1;
                    }
                    if (rest < size && line.byte_at(rest) == 60) {
                        int closer = rest + 1;
                        while (closer < size && line.byte_at(closer) != 62) {
                            closer = closer + 1;
                        }
                        if (closer < size) {
                            scanner.emit(rest, closer + 1, SYN_class.STRING);
                            position = closer + 1;
                        }
                    }
                }
                continue;
            }
        }
        bool is_at_start = is_first;
        is_first = false;
        if ((mask & SYN_lang.M_COMMENT) != 0) {
            if (is_at_start) {
                for (str open in lang.start_comments) {
                    if (is_match_at(line, position, open)) {
                        scanner.emit(position, size, SYN_class.COMMENT);
                        return;
                    }
                }
            }
            int block_form = block_form_at(lang, line, position);
            if (block_form >= 0) {
                str open = lang.block_comments[block_form * 3];
                str flags = lang.block_comments[block_form * 3 + 2];
                int from = position + open.size();
                int depth = 1;
                if (flags.contains("L")) {
                    depth = 0;
                    while (from < size && line.byte_at(from) == 61) {
                        depth = depth + 1;
                        from = from + 1;
                    }
                    from = from + 1;
                }
                int end = block_end(lang, line, from, block_form, depth);
                bool is_doc = lang.has_jsdoc && open == "/*" && position + 2 < size && line.byte_at(position + 2) == 42 && !(position + 3 < size && line.byte_at(position + 3) == 47);
                int doc_bit = 0;
                if (is_doc) {
                    doc_bit = 4096;
                }
                if (end < 0) {
                    emit_comment(scanner, line, position, size, is_doc);
                    int carry = -end - 1;
                    if (carry > 15) {
                        carry = 15;
                    }
                    scanner.state = K_BLOCK | (block_form << 4) | (carry << 8) | doc_bit;
                    return;
                }
                emit_comment(scanner, line, position, end, is_doc);
                position = end;
                pending = 0;
                continue;
            }
            if (is_line_comment_at(lang, line, position)) {
                scanner.emit(position, size, SYN_class.COMMENT);
                return;
            }
        }
        if (lang.has_regex && byte == 47) {
            int end = regex_end(line, position);
            if (end > 0) {
                scanner.emit(position, end, SYN_class.STRING);
                position = end;
                pending = 0;
                continue;
            }
        }
        if ((mask & SYN_lang.M_STRING) != 0) {
            int str_form = string_form_at(lang, line, position);
            if (str_form >= 0) {
                int body = position + lang.strings[str_form * 4].size();
                int lvl = 0;
                str flags = lang.strings[str_form * 4 + 3];
                if (flags.contains("R") || flags.contains("L")) {
                    int packed = open_end(lang, line, position, str_form);
                    body = packed & 0xFFFFF;
                    lvl = packed >> 20;
                }
                int end = string_end(lang, line, body, str_form, lvl);
                int class_value = SYN_class.STRING;
                if (end < 0) {
                    emit_string(scanner, lang, line, position, size, str_form, class_value);
                    if (flags.contains("m")) {
                        scanner.state = K_STRING | (str_form << 4) | (lvl << 8);
                    }
                    return;
                }
                if (lang.has_string_keys) {
                    int look = end;
                    while (look < size && is_space(line.byte_at(look))) {
                        look = look + 1;
                    }
                    if (look < size && line.byte_at(look) == 58) {
                        class_value = SYN_class.PROPERTY;
                    }
                }
                emit_string(scanner, lang, line, position, end, str_form, class_value);
                position = end;
                pending = 0;
                is_command = false;
                continue;
            }
        }
        if ((mask & SYN_lang.M_DIGIT) != 0) {
            int next = 0;
            if (position + 1 < size) {
                next = line.byte_at(position + 1);
            }
            bool is_starting = byte >= 48 && byte <= 57;
            if (byte == 45) {
                is_starting = next >= 48 && next <= 57 && (position == 0 || !(is_alnum(line.byte_at(position - 1)) || line.byte_at(position - 1) == 41 || line.byte_at(position - 1) == 93));
            }
            if (is_starting) {
                int from = position;
                if (byte == 45) {
                    from = position + 1;
                }
                int end = number_end(line, from);
                scanner.emit(position, end, SYN_class.NUMBER);
                position = end;
                pending = 0;
                is_command = false;
                continue;
            }
        }
        if ((mask & SYN_lang.M_WORD) != 0) {
            int stop = position + 1;
            while (stop < size && (lang.start[line.byte_at(stop)] & SYN_lang.M_BODY) != 0) {
                stop = stop + 1;
            }
            // a string prefix: r"..", b'..', f".."
            if (stop - position <= 2 && stop < size && lang.str_prefix.size() > 0 && (line.byte_at(stop) == 34 || line.byte_at(stop) == 39)) {
                bool is_all = true;
                for (int step in position .. stop) {
                    if (!lang.str_prefix.contains(str.from_chars([line.byte_at(step)]))) {
                        is_all = false;
                    }
                }
                if (is_all) {
                    int str_form = string_form_at(lang, line, stop);
                    if (str_form >= 0) {
                        int body = stop + lang.strings[str_form * 4].size();
                        str flags = lang.strings[str_form * 4 + 3];
                        int end = string_end(lang, line, body, str_form, 0);
                        if (end < 0) {
                            scanner.emit(position, size, SYN_class.STRING);
                            if (flags.contains("m")) {
                                scanner.state = K_STRING | (str_form << 4);
                            }
                            return;
                        }
                        scanner.emit(position, end, SYN_class.STRING);
                        position = end;
                        continue;
                    }
                }
            }
            bool was_command = is_command;
            is_command = false;
            if (is_first_word) {
                is_first_word = false;
                is_import_line = is_import_word(line, position, stop);
            }
            if (lang.has_immediates && stop - position > 1 && (byte == 36 || byte == 35) && is_digit_byte(line.byte_at(position + 1))) {
                scanner.emit(position, stop, SYN_class.NUMBER);
                position = stop;
                is_command = false;
                continue;
            }
            int entry = lang.lookup(line, position, stop);
            int class_value = SYN_class.NORMAL;
            int look = stop;
            while (look < size && is_space(line.byte_at(look))) {
                look = look + 1;
            }
            if (entry != 0) {
                class_value = entry & 0xFF;
                if (class_value == SYN_class.TYPE && lang.has_type_calls && stop < size && line.byte_at(stop) == 40) {
                    class_value = SYN_class.CALL;
                }
                int decl = (entry >> 8) & 3;
                if (decl != 0) {
                    pending = decl;
                } else {
                    pending = 0;
                }
                if (class_value == SYN_class.KEYWORD && lang.has_commands && is_command_keyword(line, position, stop)) {
                    is_command = true;
                }
            } else if (pending != 0) {
                if (pending == SYN_lang.DECL_FN) {
                    class_value = SYN_class.FUNCTION;
                } else {
                    class_value = SYN_class.TYPE;
                }
                pending = 0;
            } else if (lang.has_commands && was_command) {
                if (stop < size && line.byte_at(stop) == 61) {
                    is_command = true;
                    // NAME=value: a bare value is a string
                    int value_end = stop + 1;
                    while (value_end < size && !is_space(line.byte_at(value_end)) && line.byte_at(value_end) != 59 && line.byte_at(value_end) != 124 && line.byte_at(value_end) != 38 && line.byte_at(value_end) != 36 && line.byte_at(value_end) != 34 && line.byte_at(value_end) != 39 && line.byte_at(value_end) != 96 && line.byte_at(value_end) != 40 && line.byte_at(value_end) != 41) {
                        value_end = value_end + 1;
                    }
                    if (value_end > stop + 1) {
                        scanner.emit(stop + 1, value_end, SYN_class.STRING);
                        stop = value_end;
                    }
                } else {
                    class_value = SYN_class.CALL;
                }
            } else if ((lang.has_arrow_keys || lang.has_object_keys) && look < size && line.byte_at(look) == 58 && !(look + 1 < size && line.byte_at(look + 1) == 58) && is_object_key(lang, line, position, look)) {
                class_value = SYN_class.PROPERTY;
                if (lang.has_arrow_keys && is_function_value(line, look + 1)) {
                    class_value = SYN_class.FUNCTION;
                }
            } else if (lang.has_keys && look < size && ((line.byte_at(look) == 58 && !(look + 1 < size && line.byte_at(look + 1) == 58)) || (line.byte_at(look) == 61 && !(look + 1 < size && line.byte_at(look + 1) == 61)))) {
                class_value = SYN_class.PROPERTY;
            } else if (lang.has_calls && stop < size && line.byte_at(stop) == 40) {
                class_value = SYN_class.CALL;
            } else if (lang.has_bang_calls && stop + 1 < size && line.byte_at(stop) == 33 && (line.byte_at(stop + 1) == 40 || line.byte_at(stop + 1) == 91 || line.byte_at(stop + 1) == 123)) {
                class_value = SYN_class.CALL;
            } else if (lang.has_members && !is_import_line && position > 0 && !(lang.has_caps && line.byte_at(position) >= 65 && line.byte_at(position) <= 90 && (stop - position > 1 || lang.has_single_caps)) && ((line.byte_at(position - 1) == 46 && (position < 2 || line.byte_at(position - 2) != 46)) || (line.byte_at(position - 1) == 62 && position > 1 && line.byte_at(position - 2) == 45))) {
                class_value = SYN_class.MEMBER;
            } else if (lang.has_caps && line.byte_at(position) >= 65 && line.byte_at(position) <= 90 && (stop - position > 1 || lang.has_single_caps)) {
                bool has_lower = false;
                for (int step in position + 1 .. stop) {
                    int chr = line.byte_at(step);
                    if (chr >= 97 && chr <= 122) {
                        has_lower = true;
                    }
                }
                if (has_lower) {
                    if (lang.has_capital_types) {
                        class_value = SYN_class.TYPE;
                    }
                } else {
                    class_value = SYN_class.CONSTANT;
                    if (lang.has_decl_types) {
                        // GCM_CONTEXT *ctx, FOO bar: a type
                        int peek = stop;
                        while (peek < size && is_space(line.byte_at(peek))) {
                            peek = peek + 1;
                        }
                        if (peek < size && line.byte_at(peek) == 42) {
                            peek = peek + 1;
                            while (peek < size && is_space(line.byte_at(peek))) {
                                peek = peek + 1;
                            }
                        }
                        if (peek < size && peek > stop - 0 && is_alpha(line.byte_at(peek))) {
                            class_value = SYN_class.TYPE;
                        }
                    }
                }
            }
            if (lang.has_decl_types) {
                if (class_value == SYN_class.NORMAL && was_command == false) {
                    // two plain words in a row: `block128_f key`, `uint32 n`
                    if (last_plain_stop > 0 && last_plain_stop <= position) {
                        bool is_only_space = true;
                        for (int gap in last_plain_stop .. position) {
                            if (!is_space(line.byte_at(gap))) {
                                is_only_space = false;
                            }
                        }
                        if (is_only_space && position > last_plain_stop) {
                            scanner.emit(last_plain_start, last_plain_stop, SYN_class.TYPE);
                        }
                    }
                    last_plain_start = position;
                    last_plain_stop = stop;
                } else {
                    last_plain_stop = 0;
                }
            }
            scanner.emit(position, stop, class_value);
            position = stop;
            continue;
        }
        if ((mask & SYN_lang.M_SIGIL) != 0 && position + 1 < size) {
            int stop = variable_end(line, position);
            if (stop > position + 1) {
                int named = variable_constant(line, position, stop);
                if (named >= 0) {
                    scanner.emit(named >> 20, named & 0xFFFFF, SYN_class.CONSTANT);
                }
                position = stop;
                pending = 0;
                is_command = false;
                continue;
            }
        }
        if ((mask & SYN_lang.M_ATTR) != 0) {
            bool is_done = false;
            for (str open in lang.attr_open) {
                if (!is_done && is_match_at(line, position, open)) {
                    int depth = 0;
                    int stop = position + open.size();
                    depth = 1;
                    while (stop < size && depth > 0) {
                        int chr = line.byte_at(stop);
                        if (chr == 91) {
                            depth = depth + 1;
                        } else if (chr == 93) {
                            depth = depth - 1;
                        }
                        stop = stop + 1;
                    }
                    // #[derive(Debug, Clone)]: the brackets are plain, a name followed
                    // by `(` is a call, a capitalised name a type, strings strings
                    int inner = position + open.size();
                    int inner_end = stop - 1;
                    while (inner < inner_end) {
                        int inner_byte = line.byte_at(inner);
                        if (is_alpha(inner_byte)) {
                            int word_stop = inner;
                            while (word_stop < inner_end && is_alnum(line.byte_at(word_stop))) {
                                word_stop = word_stop + 1;
                            }
                            if (word_stop < inner_end && line.byte_at(word_stop) == 40) {
                                scanner.emit(inner, word_stop, SYN_class.CALL);
                            } else if (inner_byte >= 65 && inner_byte <= 90) {
                                scanner.emit(inner, word_stop, SYN_class.TYPE);
                            }
                            inner = word_stop;
                        } else if (inner_byte == 34) {
                            int str_stop = inner + 1;
                            while (str_stop < inner_end && line.byte_at(str_stop) != 34) {
                                if (line.byte_at(str_stop) == 92) {
                                    str_stop = str_stop + 1;
                                }
                                str_stop = str_stop + 1;
                            }
                            if (str_stop < inner_end) {
                                str_stop = str_stop + 1;
                            }
                            scanner.emit(inner, str_stop, SYN_class.STRING);
                            inner = str_stop;
                        } else {
                            inner = inner + 1;
                        }
                    }
                    position = stop;
                    is_done = true;
                }
            }
            if (is_done) {
                continue;
            }
            if (lang.attr.contains(str.from_chars([byte])) && position + 1 < size && is_alpha(line.byte_at(position + 1)) && (position == 0 || !is_alnum(line.byte_at(position - 1)))) {
                int stop = position + 1;
                while (stop < size && (is_alnum(line.byte_at(stop)) || line.byte_at(stop) == 46)) {
                    stop = stop + 1;
                }
                scanner.emit(position, stop, SYN_class.ATTRIBUTE);
                position = stop;
                continue;
            }
        }
        if (lang.has_heredoc && byte == 60 && position + 2 < size && line.byte_at(position + 1) == 60 && line.byte_at(position + 2) != 60) {
            int probe = position + 2;
            if (line.byte_at(probe) == 45 || line.byte_at(probe) == 126) {
                probe = probe + 1;
            }
            int quote = 0;
            if (probe < size && (line.byte_at(probe) == 39 || line.byte_at(probe) == 34)) {
                quote = line.byte_at(probe);
                probe = probe + 1;
            }
            int word = probe;
            while (probe < size && is_alnum(line.byte_at(probe))) {
                probe = probe + 1;
            }
            if (probe > word && is_alpha(line.byte_at(word))) {
                heredoc = SYN_lang.hash_of(line, word, probe, false);
                position = probe;
                continue;
            }
        }
        pending = 0;
        position = position + 1;
    }
    if (heredoc != 0) {
        scanner.state = K_HEREDOC | (heredoc << 12);
    } else if (lang.has_commands && scanner.state == 0) {
        // a trailing backslash: the next line continues this command
        int finish = size;
        while (finish > 0 && (is_space(line.byte_at(finish - 1)) || line.byte_at(finish - 1) == 13)) {
            finish = finish - 1;
        }
        if (finish > 0 && line.byte_at(finish - 1) == 92) {
            scanner.state = K_CONTINUED;
        }
    }
}
