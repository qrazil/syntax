/// Every language name, in id order (an id is the 1-based position).
pub List<str> names() {
    return ["c", "cpp", "go", "javascript", "typescript", "json", "jsonc", "m31", "python", "rust", "sh", "toml", "yaml", "markdown", "java", "csharp", "kotlin", "swift", "php", "ruby", "lua", "perl", "r", "dart", "scala", "groovy", "haskell", "elixir", "erlang", "clojure", "ocaml", "fsharp", "zig", "nim", "julia", "sql", "css", "scss", "less", "dockerfile", "makefile", "cmake", "nix", "powershell", "bat", "fish", "vim", "awk", "hcl", "protobuf", "graphql", "html", "xml", "vue", "svelte", "diff", "gitcommit", "gitrebase", "gitignore", "ini", "csv", "latex", "asm", "gomod", "nginx"];
}

/// The 1-based id of a language name, 0 when unknown.
pub int id_of(str name) {
    int position = 1;
    for (str known in names()) {
        if (known == name) {
            return position;
        }
        position = position + 1;
    }
    return 0;
}

/// The name of an id, "" when unknown.
pub str name_of(int id) {
    List<str> all = names();
    if (id < 1 || id > all.size()) {
        return "";
    }
    return all[id - 1];
}

/// Build the language called `name`; unknown names answer plain text.
pub SYN_lang.Lang load(str name) {
