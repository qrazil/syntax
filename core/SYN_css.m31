// CSS, SCSS and Less: selectors (tags, classes, ids, pseudo-classes and
// attribute selectors), declarations (property names, numbers with their
// units, colours, strings, functions, !important) and at-rules, with block
// comments carried across lines.
//
// Own state
//   bits 0..3   kind: 0 normal, 1 inside a block comment
//   bits 4..7   context of the current statement: 0 not decided yet, 1 a
//               selector, 2 a declaration's value, 3 an at-rule's prelude
//   bits 8..11  block depth (saturating at 15)

import core.SYN_class;
import core.SYN_lang;
import core.SYN_scanner;

bool is_space(int byte) {
    return byte == 32 || byte == 9 || byte == 13;
}

bool is_digit(int byte) {
    return byte >= 48 && byte <= 57;
}

bool is_name_start(int byte) {
    return (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95 || byte == 45 || byte >= 128;
}

bool is_name(int byte) {
    return is_name_start(byte) || is_digit(byte);
}

bool is_hex(int byte) {
    return is_digit(byte) || (byte >= 97 && byte <= 102) || (byte >= 65 && byte <= 70);
}

int name_end(str line, int from) {
    int position = from;
    while (position < line.size() && is_name(line.byte_at(position))) {
        position = position + 1;
    }
    return position;
}

// after `from`, which of `{`, `;`, `}` comes first on the line (123, 59,
// 125), or 0 when none does; strings and parentheses are skipped
int terminator_after(str line, int from) {
    int position = from;
    int parens = 0;
    while (position < line.size()) {
        int byte = line.byte_at(position);
        if (byte == 34 || byte == 39) {
            position = position + 1;
            while (position < line.size() && line.byte_at(position) != byte) {
                if (line.byte_at(position) == 92) {
                    position = position + 1;
                }
                position = position + 1;
            }
        } else if (byte == 47 && position + 1 < line.size() && line.byte_at(position + 1) == 42) {
            return 0;
        } else if (byte == 40) {
            parens = parens + 1;
        } else if (byte == 41 && parens > 0) {
            parens = parens - 1;
        } else if (parens == 0 && (byte == 123 || byte == 59 || byte == 125)) {
            return byte;
        }
        position = position + 1;
    }
    return 0;
}

// a number with its unit: the end of both; the number is NUMBER, the unit
// (tree-sitter calls it a string) STRING
int emit_number(SYN_scanner.Scanner scanner, str line, int from) {
    int size = line.size();
    int position = from;
    if (position < size && (line.byte_at(position) == 45 || line.byte_at(position) == 43)) {
        position = position + 1;
    }
    while (position < size && (is_digit(line.byte_at(position)) || line.byte_at(position) == 46)) {
        position = position + 1;
    }
    if (position + 1 < size && (line.byte_at(position) == 101 || line.byte_at(position) == 69) && (is_digit(line.byte_at(position + 1)) || line.byte_at(position + 1) == 45)) {
        position = position + 2;
        while (position < size && is_digit(line.byte_at(position))) {
            position = position + 1;
        }
    }
    scanner.emit(from, position, SYN_class.NUMBER);
    int unit = position;
    if (unit < size && line.byte_at(unit) == 37) {
        unit = unit + 1;
    } else {
        while (unit < size && ((line.byte_at(unit) >= 97 && line.byte_at(unit) <= 122) || (line.byte_at(unit) >= 65 && line.byte_at(unit) <= 90))) {
            unit = unit + 1;
        }
    }
    scanner.emit(position, unit, SYN_class.STRING);
    return unit;
}

// `@name: value` (a Less variable) is a declaration, not an at-rule
bool is_variable_declaration(str line, int start) {
    int end = name_end(line, start + 1);
    int look = end;
    while (look < line.size() && is_space(line.byte_at(look))) {
        look = look + 1;
    }
    return end > start + 1 && look < line.size() && line.byte_at(look) == 58;
}

/// Scan one line of CSS (or SCSS / Less).
pub void scan(SYN_scanner.Scanner scanner, SYN_lang.Lang lang, str line, int state) {
    int size = line.size();
    int kind = state & 15;
    int context = (state >> 4) & 15;
    int depth = (state >> 8) & 15;
    int position = 0;
    bool has_line_comments = lang.line_comments.size() > 0;
    scanner.state = 0;
    if (kind == 1) {
        int stop = line.index_of("*/").or(-1);
        if (stop < 0) {
            scanner.emit(0, size, SYN_class.COMMENT);
            scanner.state = state;
            return;
        }
        scanner.emit(0, stop + 2, SYN_class.COMMENT);
        position = stop + 2;
    }
    bool is_name_pending = false;
    while (position < size) {
        int byte = line.byte_at(position);
        int next = 0;
        if (position + 1 < size) {
            next = line.byte_at(position + 1);
        }
        if (is_space(byte)) {
            position = position + 1;
            continue;
        }
        if (byte == 47 && next == 42) {
            int stop = line.substr(position + 2, size).index_of("*/").or(-1);
            if (stop < 0) {
                scanner.emit(position, size, SYN_class.COMMENT);
                scanner.state = 1 | (context << 4) | (depth << 8);
                return;
            }
            scanner.emit(position, position + 2 + stop + 2, SYN_class.COMMENT);
            position = position + 2 + stop + 2;
            continue;
        }
        if (has_line_comments && byte == 47 && next == 47) {
            scanner.emit(position, size, SYN_class.COMMENT);
            return;
        }
        if (byte == 123) {
            if (depth < 15) {
                depth = depth + 1;
            }
            context = 0;
            position = position + 1;
            continue;
        }
        if (byte == 125) {
            if (depth > 0) {
                depth = depth - 1;
            }
            context = 0;
            position = position + 1;
            continue;
        }
        if (byte == 59) {
            context = 0;
            position = position + 1;
            continue;
        }
        if (context == 0) {
            is_name_pending = false;
            if (byte == 64 && !is_variable_declaration(line, position)) {
                context = 3;
            } else {
                int end = terminator_after(line, position);
                if (end == 123) {
                    context = 1;
                } else if (end == 59 || end == 125) {
                    context = 2;
                    is_name_pending = true;
                } else if (depth > 0 && line.substr(position, size).contains(":")) {
                    context = 2;
                    is_name_pending = true;
                } else {
                    context = 1;
                }
            }
        }
        if (byte == 34 || byte == 39) {
            int stop = position + 1;
            while (stop < size && line.byte_at(stop) != byte) {
                if (line.byte_at(stop) == 92) {
                    stop = stop + 1;
                }
                stop = stop + 1;
            }
            if (stop < size) {
                stop = stop + 1;
            }
            scanner.emit(position, stop, SYN_class.STRING);
            position = stop;
            continue;
        }
        if (context == 1) {
            // selector
            if (byte == 46 && is_name_start(next)) {
                int end = name_end(line, position + 1);
                scanner.emit(position + 1, end, SYN_class.TYPE);
                position = end;
                continue;
            }
            if (byte == 35 && is_name_start(next)) {
                int end = name_end(line, position + 1);
                scanner.emit(position + 1, end, SYN_class.CONSTANT);
                position = end;
                continue;
            }
            if (byte == 58) {
                int from = position + 1;
                if (next == 58) {
                    from = position + 2;
                }
                int end = name_end(line, from);
                if (end > from) {
                    scanner.emit(from, end, SYN_class.ATTRIBUTE);
                    position = end;
                    continue;
                }
            }
            if (byte == 91) {
                int stop = position + 1;
                while (stop < size && line.byte_at(stop) != 93) {
                    stop = stop + 1;
                }
                int name = name_end(line, position + 1);
                scanner.emit(position + 1, name, SYN_class.ATTRIBUTE);
                int bracket_at = name;
                while (bracket_at < stop && (line.byte_at(bracket_at) == 61 || line.byte_at(bracket_at) == 126 || line.byte_at(bracket_at) == 124 || line.byte_at(bracket_at) == 94 || line.byte_at(bracket_at) == 36 || line.byte_at(bracket_at) == 42)) {
                    bracket_at = bracket_at + 1;
                }
                if (bracket_at < stop && line.byte_at(bracket_at) != 34 && line.byte_at(bracket_at) != 39) {
                    scanner.emit(bracket_at, stop, SYN_class.STRING);
                    position = stop;
                    continue;
                }
                position = name;
                continue;
            }
            if (is_digit(byte)) {
                position = emit_number(scanner, line, position);
                continue;
            }
            if (is_name_start(byte)) {
                int end = name_end(line, position);
                int class_value = SYN_class.TAG;
                str word = line.substr(position, end);
                if (depth > 0 && (word == "from" || word == "to")) {
                    class_value = SYN_class.KEYWORD;
                }
                if (position > 0 && (line.byte_at(position - 1) == 38 || line.byte_at(position - 1) == 36)) {
                    class_value = SYN_class.NORMAL;
                }
                scanner.emit(position, end, class_value);
                position = end;
                continue;
            }
            position = position + 1;
            continue;
        }
        if (context == 3) {
            // bracket_at-rule prelude
            if (byte == 64) {
                int end = name_end(line, position + 1);
                str word = line.substr(position, end);
                if (word == "@import") {
                    scanner.emit(position, end, SYN_class.KEYWORD);
                } else {
                    scanner.emit(position, end, SYN_class.PREPROC);
                }
                position = end;
                continue;
            }
            if (is_digit(byte)) {
                position = emit_number(scanner, line, position);
                continue;
            }
            if (is_name_start(byte)) {
                int end = name_end(line, position);
                str word = line.substr(position, end);
                int look = end;
                while (look < size && is_space(line.byte_at(look))) {
                    look = look + 1;
                }
                if (word == "and" || word == "or" || word == "not" || word == "only") {
                    scanner.emit(position, end, SYN_class.KEYWORD);
                } else if (look < size && line.byte_at(look) == 58 && position > 0 && line.byte_at(position - 1) == 40) {
                    scanner.emit(position, end, SYN_class.PROPERTY);
                } else if (end < size && line.byte_at(end) == 40) {
                    scanner.emit(position, end, SYN_class.FUNCTION);
                }
                position = end;
                continue;
            }
            position = position + 1;
            continue;
        }
        // a declaration
        if (is_name_pending) {
            is_name_pending = false;
            if (is_name_start(byte) || byte == 36 || byte == 64) {
                int end = name_end(line, position + 1);
                int look = end;
                while (look < size && is_space(line.byte_at(look))) {
                    look = look + 1;
                }
                if (look < size && line.byte_at(look) == 58) {
                    if (!(byte == 45 && next == 45)) {
                        scanner.emit(position, end, SYN_class.PROPERTY);
                    }
                    position = look + 1;
                    continue;
                }
            }
        }
        if (byte == 35 && position + 1 < size && is_hex(next)) {
            int end = position + 1;
            while (end < size && is_hex(line.byte_at(end))) {
                end = end + 1;
            }
            scanner.emit(position, end, SYN_class.STRING);
            position = end;
            continue;
        }
        if (is_digit(byte) || (byte == 46 && is_digit(next)) || ((byte == 45 || byte == 43) && (is_digit(next) || (next == 46 && position + 2 < size && is_digit(line.byte_at(position + 2)))))) {
            position = emit_number(scanner, line, position);
            continue;
        }
        if (byte == 33) {
            int end = name_end(line, position + 1);
            scanner.emit(position, end, SYN_class.KEYWORD);
            position = end;
            continue;
        }
        if (is_name_start(byte)) {
            int end = name_end(line, position);
            if (end < size && line.byte_at(end) == 40 && !(byte == 45 && next == 45)) {
                scanner.emit(position, end, SYN_class.FUNCTION);
            }
            position = end;
            continue;
        }
        position = position + 1;
    }
    scanner.state = (context << 4) | (depth << 8);
}
